#!/usr/bin/env python3
import sys

sys.path.append("../timecount")


from timecount import process
from timecount.tctypes import (
    EmploymentContract,
    Balance,
    Day,
    HoliDay,
    SickDay,
    VacationDay,
)

# fmt: off
entries_with_breaks = [
    EmploymentContract(begin="01-04-2020", vacation_days_per_year=29, hours_per_week=30, workdays_per_week=4, automatically_deduct_breaks="german"),
    
    # Automatic break deduction through worktime
    Day("01-04-2020", (08.00, 14.00), "6 hours work"),
    Day("02-04-2020", (08.00, 17.00), "9 hours work"),
    Day("03-04-2020", (08.00, 15.00), "7 hours work"),
    Day("04-04-2020", (08.00, 13.00), "5 hours work"),
    
    # Automatic break deduction through gaps (+ worktime)
    # 8 hours work with 1 hour break gap - should detect break and not deduct additional
    Day("05-04-2020", (08.00, 12.00), (13.00, 17.00), "8 hours with 1h continuous break gap"),
    
    # 8:15 hours work with 45 min break gap - should detect 30min requirement and 15min requirement
    Day("06-04-2020", (08.00, 12.00), (12.45, 17.00), "8:15 hours with 45min continuous break gap"),
    
    # 7:15 hours work with only a 15 min break gap - 15min is not enough, full 30min are deducted
    Day("07-04-2020", (08.00, 12.00), (12.15, 16.30), "7:15 hours with only a 15min break gap (should deduct 30min)"),
    
    # Multiple small gaps - should NOT be counted as they are not continuous 30min blocks
    Day("08-04-2020", (08.00, 10.00), (10.10, 12.00), (12.20, 16.20), "7:50 hours with multiple small gaps (10min + 20min)"),
    
    # 9+ hours with proper 30min + 15min breaks
    Day("09-04-2020", (08.00, 12.00), (12.30, 14.00), (14.15, 18.00), "9:45 hours with 30min + 15min gaps"),
    
    # 9+ hours with only 45min break (should detect as 30min + need 15min more)
    Day("10-04-2020", (08.00, 12.00), (12.45, 18.00), "9:15 hours with only 45min break"),
]

process(entries_with_breaks)
